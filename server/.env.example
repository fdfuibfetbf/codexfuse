# --- Core ---
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codexfuse?schema=public

# --- Auth ---
JWT_SECRET=replace-with-32-byte-random-string
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- AI Providers (any subset) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Storage (optional, defaults to local /uploads) ---
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads

# --- Demo / seed ---
SEED_ADMIN_EMAIL=admin@codexfuse.app
SEED_ADMIN_PASSWORD=ChangeMe123!
